# DataLedger Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-at-least-32-chars
APP_DEBUG=true

# Database
# For local dev: sqlite+aiosqlite:///./dataledger.db
# For production: postgresql+asyncpg://user:pass@host:5432/dataledger
DATABASE_URL=sqlite+aiosqlite:///./dataledger.db

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Optional: Redis for background jobs
# REDIS_URL=redis://localhost:6379/0
